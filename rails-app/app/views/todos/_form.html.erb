<%= form_with(model: todo) do |form| %>
  <% if todo.errors.any? %>
    <div class="errors">
      <strong><%= pluralize(todo.errors.count, "erro") %> impediram o salvamento:</strong>
      <ul>
        <% todo.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :title, "Identificação da missão" %>
    <%= form.text_field :title, placeholder: "Ex.: Estudar Kubernetes", autofocus: true %>
  </div>

  <div class="field check-field">
    <%= form.check_box :completed %>
    <%= form.label :completed, "Marcar missão como concluída" %>
  </div>

  <%= form.submit "Salvar diretiva", class: "btn btn-primary" %>
<% end %>
