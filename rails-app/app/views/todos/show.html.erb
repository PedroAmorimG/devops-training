<% content_for :title, @todo.title %>

<div class="hero">
  <div class="eyebrow">Arquivo / task_<%= format("%03d", @todo.id) %></div>
  <h1>Dados da <span>missão.</span></h1>
  <p>Leitura dos parâmetros armazenados no sistema.</p>
</div>

<div class="card">
  <span class="panel-label">// Registro completo</span>
  <dl class="detail-list">
    <div class="detail-row">
      <dt>Diretiva</dt>
      <dd><%= @todo.title %></dd>
    </div>
    <div class="detail-row">
      <dt>Estado</dt>
      <dd>
        <% if @todo.completed? %>
          <span class="badge badge-done">Concluída</span>
        <% else %>
          <span class="badge badge-pending">Pendente</span>
        <% end %>
      </dd>
    </div>
    <div class="detail-row">
      <dt>Criada em</dt>
      <dd><%= l(@todo.created_at, format: :long) rescue @todo.created_at.strftime("%d/%m/%Y às %H:%M") %></dd>
    </div>
  </dl>

  <div class="actions">
    <%= link_to "Editar missão", edit_todo_path(@todo), class: "btn btn-primary" %>
    <%= button_to "Excluir registro", @todo, method: :delete, class: "btn btn-ghost btn-danger", data: { turbo_confirm: "Excluir esta tarefa?" } %>
  </div>
</div>

<%= link_to "← Retornar ao painel", todos_path, class: "btn btn-ghost btn-back" %>
