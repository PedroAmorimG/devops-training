<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Neon Task" %> // NEON TASK</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Neon Task">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="topbar">
      <%= link_to root_path, class: "brand", aria: { label: "Neon Task — início" } do %>
        <span class="brand-mark" aria-hidden="true"></span>
        <span>NEON<span class="brand-accent">//</span>TASK</span>
      <% end %>
      <div class="system-status" aria-label="Sistema operacional">
        <span class="status-dot" aria-hidden="true"></span>
        <span>system online</span>
      </div>
    </header>
    <main class="container">
      <% if notice %>
        <p class="notice"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="alert"><%= alert %></p>
      <% end %>
      <%= yield %>
    </main>
    <footer class="app-footer">
      build <strong><%= ENV.fetch("APP_VERSION", "dev") %></strong> // node <strong><%= ENV.fetch("HOSTNAME") { Socket.gethostname } %></strong>
    </footer>
  </body>
</html>
